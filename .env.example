APP_NAME="Sentinel Slop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sentinel-slop.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Herd MySQL/Memurai defaults. Production: values from Forge.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sentinel_slop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Horizon requires redis. Locally on Windows run `php artisan queue:work redis --queue=scans` and a second worker for `default`.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (live scan progress). `php artisan reverb:install` fills these in.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# GitHub App (github.com → Settings → Developer settings → GitHub Apps → your app)
# Permissions needed: Repository contents: Read-only, Metadata: Read-only.
# Subscribe to events: Installation, Installation repositories.
# ---------------------------------------------------------------------------
# "App ID" shown at the top of the app's General page.
GITHUB_APP_ID=
# The slug in the app's public URL: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# "Client ID" on the General page. Used for "Sign in with GitHub".
GITHUB_APP_CLIENT_ID=
# General page → "Client secrets" → Generate a new client secret.
GITHUB_APP_CLIENT_SECRET=
# Must match APP_URL + /auth/github/callback and the app's "Callback URL".
GITHUB_APP_REDIRECT_URI=http://sentinel-slop.test/auth/github/callback
# General page → Webhook → "Webhook secret". Pick a long random string and paste it in both places.
# Webhook URL: <public URL from `herd share`>/webhooks/github
GITHUB_APP_WEBHOOK_SECRET=
# General page → "Private keys" → Generate a private key. Save the .pem here (the folder is gitignored).
# Relative paths are resolved from the project root.
GITHUB_APP_PRIVATE_KEY_PATH=storage/keys/github-app.pem
# Production alternative: the PEM itself, base64-encoded on one line (`base64 -w0 github-app.pem`), injected from a
# secrets manager. Takes precedence over the path when set.
GITHUB_APP_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Sentinel Slop
# ---------------------------------------------------------------------------
# Prism provider/model used to generate prompts. Any Prism-supported provider works.
SENTINEL_LLM_PROVIDER=anthropic
SENTINEL_LLM_MODEL=claude-sonnet-5
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Comma-separated GitHub usernames allowed to open /horizon outside local.
SENTINEL_ADMIN_GITHUB_USERNAMES=
SENTINEL_SCANS_PER_HOUR=5
# Analyser binaries. PHP/Node tools are bundled; Semgrep and gitleaks are system binaries (see README).
SENTINEL_SEMGREP_BINARY=semgrep
SENTINEL_GITLEAKS_BINARY=gitleaks
SENTINEL_NODE_BINARY=node
# Where fetched repos live during a scan (deleted after every scan).
# SENTINEL_SCAN_STORAGE_PATH=
# SENTINEL_MAX_TOTAL_BYTES=157286400   # counted over analysable files only, see config/sentinel.php
# SENTINEL_MAX_FILE_COUNT=12000
# SENTINEL_JOB_TIMEOUT=2700           # one pipeline stage; Redis retry_after follows it
# SENTINEL_TOOL_TIMEOUT=900           # one analyser run
# SENTINEL_WORKER_MEMORY_LIMIT=1G     # what sentinel:doctor --strict requires of php.ini
# SENTINEL_MAX_SINGLE_FILE_BYTES=1048576

# Ruff for Python repositories: `pip install ruff`, then the full path if it is not on PATH.
SENTINEL_RUFF_BINARY=ruff
