{
    "minLines": 10,
    "minTokens": 70,
    "mode": "mild",
    "gitignore": false,
    "absolute": true,
    "silent": true,
    "noSymlinks": true,
    "format": ["php", "javascript", "typescript", "jsx", "tsx", "python"],
    "ignore": ["**/node_modules/**", "**/vendor/**", "**/dist/**", "**/build/**", "**/*.min.js", "**/*.blade.php"],
    "reporters": ["json"]
}
