# Copy to backend.hcl (gitignored) and create the bucket and table once:
#   aws s3api create-bucket --bucket <bucket> --region eu-west-2 --create-bucket-configuration LocationConstraint=eu-west-2
#   aws s3api put-bucket-versioning --bucket <bucket> --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name <table> --attribute-definitions AttributeName=LockID,AttributeType=S \
#       --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST --region eu-west-2
bucket         = "your-terraform-state-bucket"
key            = "sentinel-slop/prod/terraform.tfstate"
region         = "eu-west-2"
dynamodb_table = "your-terraform-locks"
encrypt        = true
